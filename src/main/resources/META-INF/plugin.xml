<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件唯一标识符 -->
    <id>com.codereview.plugin</id>

    <!-- 插件名称 -->
    <name>DingCoder AI</name>

    <!-- 插件版本 -->
    <version>2.0.3</version>

    <!-- 插件供应商 -->
    <vendor email="support@example.com" url="https://www.example.com">鼎码智辅</vendor>

    <!-- 插件描述 -->
    <description><![CDATA[
        <h3>DingCoder AI - 智能代码生成与审查助手</h3>
        
        <p><strong>核心功能：</strong></p>
        <ul>
            <li>🚀 <strong>AI代码生成</strong> - 通过MQTT实时接收AI生成的Java代码，支持批量生成和确认</li>
            <li>📝 <strong>智能代码审查</strong> - 集成企业级代码审查API，支持单文件、多文件、Git差异审查</li>
            <li>⚡ <strong>一键文件生成</strong> - 智能识别类名和包结构，自动生成Java源文件到指定目录</li>
            <li>🔄 <strong>实时消息同步</strong> - MQTT消息订阅，支持代码生成状态实时更新</li>
            <li>💬 <strong>交互式聊天界面</strong> - 现代化UI设计，支持代码块展开/收缩，文本选择复制</li>
        </ul>
        
        <p><strong>技术特性：</strong></p>
        <ul>
            <li>🔐 <strong>企业级认证</strong> - 支持鼎捷云平台IAM认证，RSA+AES加密通信</li>
            <li>🌐 <strong>多环境支持</strong> - 支持生产环境和测试环境配置</li>
            <li>📊 <strong>统计分析</strong> - 代码生成和用户反馈数据统计</li>
            <li>🎨 <strong>主题适配</strong> - 完美适配IntelliJ IDEA深色/浅色主题</li>
            <li>⚙️ <strong>智能配置</strong> - 自动检测项目结构，智能选择生成目录</li>
        </ul>
        
        <p><strong>适用场景：</strong></p>
        <ul>
            <li>AI辅助代码生成</li>
            <li>AI辅助代码审查</li>
        </ul>
        
        <p><em>由鼎码智辅团队开发，为企业提供专业的AI代码生成与审查解决方案</em></p>
    ]]></description>

    <!-- 插件变更记录 -->
    <change-notes><![CDATA[
        <h3>版本 2.0.2 - 2024年最新版本</h3>
        <ul>
            <li>🎨 <strong>UI界面全面优化</strong> - 重新设计聊天界面，支持代码块展开/收缩，优化消息高度和间距</li>
            <li>📱 <strong>响应式布局</strong> - 修复拖拽窗口后布局异常问题，优化组件尺寸管理</li>
            <li>🔧 <strong>代码生成增强</strong> - 改进Java文件生成逻辑，支持智能目录检测和包结构识别</li>
            <li>💬 <strong>交互体验提升</strong> - 支持文本选择和复制，添加右键菜单功能</li>
            <li>⚡ <strong>性能优化</strong> - 优化MQTT消息处理，提升界面响应速度</li>
        </ul>
        
        <h3>版本 2.0.1 - 功能完善版</h3>
        <ul>
            <li>🔐 <strong>企业级认证</strong> - 集成鼎捷云平台IAM认证系统，支持RSA+AES加密通信</li>
            <li>📝 <strong>代码审查服务</strong> - 新增企业级代码审查API集成，支持多文件审查和Git差异分析</li>
            <li>📊 <strong>统计分析功能</strong> - 新增代码生成统计和用户反馈数据收集</li>
            <li>🌐 <strong>多环境支持</strong> - 支持生产环境和测试环境配置切换</li>
            <li>🔄 <strong>MQTT服务优化</strong> - 改进消息订阅机制，支持自动重连和错误处理</li>
        </ul>
        
        <h3>版本 2.0.0 - 重大更新版</h3>
        <ul>
            <li>🚀 <strong>AI代码生成</strong> - 核心功能实现，支持MQTT实时接收AI生成的Java代码</li>
            <li>⚡ <strong>一键文件生成</strong> - 智能识别类名，自动生成Java源文件到项目目录</li>
            <li>💬 <strong>聊天界面</strong> - 现代化聊天界面设计，支持代码展示和用户交互</li>
            <li>🔧 <strong>批量操作</strong> - 支持批量生成、批量点赞/点踩等操作</li>
            <li>🎯 <strong>项目集成</strong> - 深度集成IntelliJ IDEA，支持项目文件操作</li>
        </ul>
        
        <h3>版本 1.0.0 - 基础版本</h3>
        <ul>
            <li>🔑 <strong>基础认证</strong> - 实现用户登录和身份验证功能</li>
            <li>📡 <strong>MQTT通信</strong> - 建立与AI服务的基础通信机制</li>
            <li>🖥️ <strong>工具窗口</strong> - 创建插件主界面和基础UI组件</li>
            <li>⚙️ <strong>配置管理</strong> - 基础配置和设置管理功能</li>
        </ul>
        
        <p><em>持续更新中，更多功能敬请期待...</em></p>
    ]]></change-notes>

    <!-- IDEA版本兼容性 -->
    <idea-version since-build="203" until-build="241.*"/>

    <!-- 依赖配置 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- 扩展和行为定义 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 工具窗口扩展 -->
        <toolWindow id="鼎码智辅" secondary="true" icon="com.codereview.plugin.ui.CodeReviewIcons.MAIN_ICON" anchor="right"
                    factoryClass="com.codereview.plugin.ui.ChatToolWindowFactory"/>

        <!-- 应用级别服务 -->
        <applicationService serviceImplementation="com.codereview.plugin.auth.AuthService"/>
        <applicationService serviceImplementation="com.codereview.plugin.service.MQTTService"/>
        
        <!-- 项目级别服务 -->
        <projectService serviceImplementation="com.codereview.plugin.service.ReviewService"/>
        <projectService serviceImplementation="com.codereview.plugin.service.CodeGenerationService"/>
        
        <!-- 启动活动 - 用于在启动时检查登录状态 -->
        <postStartupActivity implementation="com.codereview.plugin.startup.LoginStartupActivity"/>
        
        <!-- 应用退出监听器 - 用于在IDEA退出时执行登出操作 -->
        <applicationListener implementation="com.codereview.plugin.startup.ApplicationShutdownListener"/>
    </extensions>

    <!-- 动作定义 -->
    <actions>
        <action id="com.codereview.plugin.action.ChatAction" 
                class="com.codereview.plugin.action.ChatAction" 
                text="鼎码智辅" 
                icon="com.codereview.plugin.ui.CodeReviewIcons.MAIN_ICON"
                description="打开鼎码智辅">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
        </action>
        
        <!-- 右键菜单分组 -->
        <group id="com.codereview.plugin.ContextMenuGroup" text="鼎码智辅" popup="true">
            <action id="com.codereview.plugin.action.CodeReviewAction"
                    class="com.codereview.plugin.action.CodeReviewAction"
                    text="代码评审"
                    description="将选中代码添加到代码评审面板">
            </action>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

<!--        &lt;!&ndash; Token刷新+MQTT重连测试Action &ndash;&gt;-->
